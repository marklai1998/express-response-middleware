{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@marklai/shared-config-biome"],
  "files": {
    "includes": ["**", "!CHANGELOG.md"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "warn"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["pnpm-lock.yaml"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
